# Server Configuration
NODE_ENV=development
PORT=3000

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production-minimum-32-characters
JWT_EXPIRES_IN=24h

# Coinflow API Configuration
COINFLOW_API_KEY=your-coinflow-api-key
COINFLOW_API_SECRET=your-coinflow-api-secret
COINFLOW_BASE_URL=https://api.coinflow.cash
COINFLOW_ENVIRONMENT=sandbox
COINFLOW_MERCHANT_ID=your-merchant-id

# CORS Configuration
CORS_ORIGIN=*

# Logging
LOG_LEVEL=info
LOG_FILE=logs/app.log

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key

# Agent System Configuration
AGENT_SYSTEM_ENABLED=true
AGENT_MAX_CONCURRENT_TASKS=100
AGENT_TASK_TIMEOUT=30000

# Network Detection Agent
NETWORK_DETECTION_CACHE_TTL=300000

# Ledger Transfer Agent
LEDGER_FEE_PERCENTAGE=0.01
LEDGER_MIN_FEE=0.01
LEDGER_MAX_AMOUNT=10000

# Notion Integration (Product Roadmap)
NOTION_API_KEY=secret_xxxxxxxxxxxxx
NOTION_ROADMAP_DATABASE_ID=abcd1234efgh5678ijkl9012mnop3456

# ============================================
# CoverPay BNPL Configuration (6 Providers)
# ============================================

# Global CoverPay Settings
COVERPAY_ENABLED=true
COVERPAY_DEFAULT_STRATEGY=waterfall
COVERPAY_MOCK_MODE=false

# --------------------------------------------
# 1. Klarna Configuration
# Docs: https://docs.klarna.com/api/payments/
# Portal: https://portal.klarna.com/
# --------------------------------------------
KLARNA_API_KEY=your-klarna-api-key
KLARNA_API_SECRET=your-klarna-api-secret
KLARNA_ENVIRONMENT=sandbox
KLARNA_REGION=US

# --------------------------------------------
# 2. Affirm Configuration
# Docs: https://docs.affirm.com/payments/docs/direct-api-overview
# Portal: https://sandbox.affirm.com/dashboard/
# --------------------------------------------
AFFIRM_PUBLIC_KEY=your-affirm-public-key
AFFIRM_PRIVATE_KEY=your-affirm-private-key
AFFIRM_ENVIRONMENT=sandbox

# --------------------------------------------
# 3. Afterpay Configuration
# Docs: https://developers.afterpay.com/afterpay-online/docs/create-order
# Portal: https://portal.sandbox.afterpay.com/
# --------------------------------------------
AFTERPAY_MERCHANT_ID=your-afterpay-merchant-id
AFTERPAY_SECRET_KEY=your-afterpay-secret-key
AFTERPAY_ENVIRONMENT=sandbox
AFTERPAY_REGION=US

# --------------------------------------------
# 4. Sezzle Configuration
# Docs: https://docs.sezzle.com/docs/api/intro
# Portal: https://dashboard.sezzle.com/
# --------------------------------------------
SEZZLE_PUBLIC_KEY=your-sezzle-public-key
SEZZLE_PRIVATE_KEY=your-sezzle-private-key
SEZZLE_ENVIRONMENT=sandbox

# --------------------------------------------
# 5. Zip (Quadpay) Configuration
# Docs: https://docs.us.zip.co/docs/custom-integration-guide
# Portal: https://merchant.us.zip.co/
# --------------------------------------------
ZIP_API_KEY=your-zip-api-key
ZIP_API_SECRET=your-zip-api-secret
ZIP_MERCHANT_ID=your-zip-merchant-id
ZIP_ENVIRONMENT=sandbox
ZIP_REGION=US

# --------------------------------------------
# 6. PayPal Pay in 4 Configuration
# Docs: https://developer.paypal.com/docs/checkout/pay-later/us/
# Portal: https://developer.paypal.com/dashboard/
# Note: Pay in 4 available for $30-$1,500 orders (US only)
# --------------------------------------------
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret
PAYPAL_ENVIRONMENT=sandbox
